{
  "enabled": true,
  "skip_authenticated": false,
  "hard_reject": {
    "rbl_on_connect": true,
    "static_on_connect": true
  },
  "rbl": {
    "enabled": false,
    "zones": ["zen.spamhaus.org"],
    "client_ip_zones": ["zen.spamhaus.org"],
    "domain_zones": ["dbl.spamhaus.org", "zrd.spamhaus.org"],
    "url_zones": [],
    "timeout_ms": 500,
    "on_dns_fail": "accept",
    "cache_ttl_listed_sec": 3600,
    "cache_ttl_miss_sec": 86400,
    "max_checks_per_message": 20,
    "spamhaus_dqs_key": "",
    "zone_codes": {
      "zrd.spamhaus.org": ["127.0.2.2-6"]
    }
  },
  "static": {
    "deny_client_ip": ["deny-ip.txt"],
    "deny_mail_from": ["deny-from.txt"],
    "deny_rcpt_to": [],
    "client_ip_tag": "IP_BLOCKED",
    "mail_from_tag": "ENV_FROM_BLOCKED",
    "rcpt_to_tag": "RCPT_BLOCKED"
  },
  "lists": {
    "spam_traps": ["spam-traps.txt"],
    "trusted_domains": ["trusted-domains.txt"],
    "url_redirectors": ["url-redirectors.txt"]
  },
  "rules": [
    {"scope": "body", "match": "(?i)click here to claim", "tag": "BODY_PHISH"}
  ],
  "spam_rules_url": "",
  "url_redirects": {
    "enabled": false,
    "timeout_ms": 2000,
    "max_redirects": 3
  },
  "content": {
    "deny_subject_regex": ["(?i)viagra"],
    "max_header_bytes": 65536
  },
  "scores": {
    "RBL_ZEN": 3.0,
    "SPF_FAIL": 5.0,
    "SPF_SOFTFAIL": 2.0,
    "DKIM_REJECT": 3.0,
    "DMARC_POLICY_REJECT": 8.0,
    "DMARC_POLICY_QUARANTINE": 4.0,
    "SUBJECT_BAD": 5.0
  },
  "thresholds": {
    "reject": 10.0,
    "discard": 15.0,
    "spam": 5.0
  },
  "tag_actions": {
    "IP_BLOCKED": "reject",
    "GTUBE_TEST": "reject"
  }
}
